# Database — local file (default). For production, point this at a Turso DB:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-token
DATABASE_URL=file:./app.db

# App
# Required for authentication. Generate at least 32 random bytes; never commit the value.
BETTER_AUTH_SECRET=
# Set in production (e.g. https://yourdomain.com). Leave empty in dev.
APP_URL=

# Stripe (test mode). Leave empty to run the app with billing disabled —
# the UI will show a "billing not configured" notice instead of breaking.
# Prefer a restricted test key (rk_test_ or rkcs_test_) over a secret key.
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Stripe webhook verification
# Local dev: stripe listen --forward-to localhost:3000/api/stripe/webhook

# Wallet payments (InstaPay and Orange Cash to +201274026227).
# Set at least one channel or the billing page will not accept a confirmation.
SLACK_BILLING_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BILLING_CHAT_ID=
# Authorization: Bearer <secret>
# POST /api/billing/wallet-activation {"requestId":"<request_id from the message>"}
BILLING_ACTIVATION_SECRET=

# Password reset email. Leave both empty to show that reset email is not configured.
# EMAIL_FROM is the Resend from address, for example InvoiceFlow <mail@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
